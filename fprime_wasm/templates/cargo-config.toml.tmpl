[target.{{target}}]
# Builds each sequence for the on-board interpreter, and writes its `.sym`.
linker = "fprime-wasm"

rustflags = [
    # The WebAssembly features F Prime {{fprime_version}}'s interpreter supports. Change them
    # together with FPRIME_VERSION below.
    "-Ctarget-cpu=mvp",
    "-Ctarget-feature={{target_features}}",

    # Guest stack size, in bytes.
    "-Clink-arg=-zstack-size={{stack_size}}",

    "-Clink-arg=--page-size=1",
]

[env]
# The F Prime release the sequences fly on.
FPRIME_VERSION = "{{fprime_version}}"

# How `wasm-opt` optimises release builds, if it is installed.
SPACEWASM_OPT = "--low-memory-unused --converge -Os"
