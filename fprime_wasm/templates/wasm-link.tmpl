#!/bin/sh

# Release linker for the sequences: `rust-lld`, then `wasm-opt`.

set -eu

rust-lld "$@"

output=""
previous=""
for argument in "$@"; do
    case "$previous" in
        -o) output="$argument" ;;
    esac
    previous="$argument"
done

if [ -z "$output" ]; then
    echo "wasm-link: no -o argument, nothing to optimise" >&2
    exit 0
fi

# Debug builds are for `fprime-wasm verify --debug`; leave them readable.
case "$output" in
    */release/*) ;;
    *) exit 0 ;;
esac

# Not fatal: the module is linked and valid, just larger than it needs to be, and
# `fprime-wasm verify` measures whatever is actually on disk.
if ! command -v wasm-opt >/dev/null 2>&1; then
    echo "wasm-link: wasm-opt not found on PATH, leaving $output unoptimised" >&2
    echo "wasm-link: it ships with binaryen: https://github.com/WebAssembly/binaryen" >&2
    exit 0
fi

# SpaceWasm feature set
wasm-opt \
    --mvp-features \
    --enable-mutable-globals \
    --enable-custom-page-sizes \
    -Os "$output" -o "$output.opt"
mv "$output.opt" "$output"
