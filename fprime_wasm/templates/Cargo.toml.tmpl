[package]
name = "{{crate_name}}"
version = "0.1.0"
edition = "2024"
publish = false

[features]
wasm = []

[dependencies]
fprime_core = "{{crate_version}}"

[build-dependencies]
fprime_build = "{{crate_version}}"

[dev-dependencies]
fprime_test = "{{crate_version}}"

[lib]
test = false
bench = false

[[bin]]
name = "{{sequence}}"
required-features = ["wasm"]
test = false
bench = false

# Optimized for smallest size
[profile.release]
lto = true
opt-level = "s"
codegen-units = 1
panic = "abort"
debug = false
strip = true
